        "def count_over(*values, limit=100):\n",
        "  \"\"\"Count how many values are over the limit.\"\"\"\n",
        "  count = 0\n",
        "  for value in values:\n",
        "      if value > limit:\n",
        "          count += 1\n",
        "  return count\n",
